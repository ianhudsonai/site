---
import { projects, links } from '../data/site';
const kilo = projects[0];

const steps = [
  {
    id: 'training',
    tab: 'Training',
    title: 'The next set, already filled in',
    text: 'Load, reps and RIR on every set, with the numbers from last time ready to go. At the end, a summary with your records and how much each exercise went up.',
    img: '/kilo/treino-aceitar-sugestao.webp',
    alt: "Kilo's training screen, in Portuguese: bench press, three sets of 60 kg by 10, and the Accept suggestion button",
  },
  {
    id: 'food',
    tab: 'Food',
    title: 'The TACO inside the phone',
    text: 'The TACO table and US foods live inside the app, so search works without a signal. Your most used foods come first in each meal, to log in one tap.',
    img: '/kilo/alimentacao-dia.webp',
    alt: "Kilo's food log, in Portuguese: banana, boiled egg, French roll and rice with their calories",
  },
  {
    id: 'weight',
    tab: 'Weight',
    title: 'A check-in once a week',
    text: 'Calories, protein, workouts and the weight trend in one screen, with a suggested adjustment to your goal. You decide whether to accept it.',
    img: '/kilo/meta-e-peso.webp',
    alt: "Kilo's goal and weight screen, in Portuguese, with the weekly check-in and the weight trend",
  },
];
---

<section id="kilo-story" class="story" aria-labelledby="story-title" data-story>
  <h2 id="story-title" class="sr-only">What Kilo does</h2>
  <div class="stage">
    {
      steps.map((s, i) => (
        <article class="step" id={`kilo-${s.id}`} data-step={i} aria-label={s.tab}>
          <div class="plate">
            <img
              src={s.img}
              width="780"
              height="1688"
              alt={s.alt}
              loading="lazy"
              class="shot hard"
            />
          </div>
          <div class="copy">
            <ul class="tabs" aria-label="Kilo screens">
              {steps.map((t, j) => (
                <li>
                  <a href={`#kilo-${t.id}`} data-tab={j} aria-current={j === i ? 'true' : undefined}>
                    {t.tab}
                  </a>
                </li>
              ))}
            </ul>
            <div class="words">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
            <div class="cells">
              <a href={kilo.href} class="cell cell-a">Join the waitlist <span aria-hidden="true">→</span></a>
              <a href={`mailto:${links.email}`} class="cell cell-b">Ask Ian</a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .story { position: relative; background: var(--fg); color: var(--bg); }
  .stage { display: block; }

  /* Static layout: each screen is its own two-column block. */
  .step {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
    scroll-margin-top: 0;
  }
  .plate {
    display: grid;
    place-items: center;
    padding: 2.5rem var(--m);
    background: var(--fg);
  }
  .shot {
    width: auto;
    height: min(82svh, 52rem);
    max-width: 100%;
    object-fit: contain;
    --sh: var(--accent);
    border: 2px solid var(--bg);
  }
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    background: var(--bg);
    color: var(--fg);
    padding: 1.25rem var(--m) var(--m);
  }
  .tabs { display: flex; gap: clamp(1rem, 2.5vw, 2rem); padding-top: 3.5rem; font-size: var(--t-b); font-weight: 600; }
  .tabs a { display: inline-flex; min-height: 2.75rem; align-items: center; color: var(--muted); border-bottom: 3px solid transparent; }
  .tabs a[aria-current='true'] { color: var(--fg); border-bottom-color: var(--accent); }
  .tabs a:hover { color: var(--fg); }
  .words h3 { font-family: var(--font-display); font-weight: 400; font-size: var(--t-h); line-height: 1.05; letter-spacing: -0.02em; max-width: 14ch; }
  .words p { margin-top: 1.5rem; max-width: 34ch; color: var(--muted); font-size: var(--t-b); }
  .cells { display: grid; grid-template-columns: 1fr 1fr; }
  .cell {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    font-weight: 700;
    font-size: var(--t-b);
    transition: background-color 0.25s, color 0.25s;
  }
  .cell-a { background: var(--accent); color: var(--on-accent); }
  .cell-a:hover { background: var(--fg); }
  .cell-b { background: var(--surface); color: var(--fg); }
  .cell-b:hover { background: var(--fg); color: var(--bg); }

  /* Motion layer: the three screens stack in one held stage and the next wipes over the last as the page scrolls. */
  html.motion .story { height: 300svh; }
  html.motion .stage { position: sticky; top: 0; height: 100svh; overflow: clip; }
  html.motion .step { position: absolute; inset: 0; min-height: 0; }
  html.motion .step[data-step='1'], html.motion .step[data-step='2'] { clip-path: inset(100% 0 0 0); }
  html.motion .step[data-step='1'] { z-index: 2; }
  html.motion .step[data-step='2'] { z-index: 3; }

  @media (max-width: 720px) {
    .step { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .plate { padding: 1rem var(--m) 0.75rem; }
    .shot { height: min(40svh, 24rem); }
    .tabs { padding-top: 0; }
    .copy { gap: 1rem; padding-top: 0.5rem; }
    .words p { margin-top: 0.75rem; }
    .cell { min-height: 3.75rem; }
    .cells { grid-template-columns: 1fr; }
    html.motion .step { grid-template-rows: 42svh 1fr; }
  }
</style>
