---
import { projects } from '../data/site';
const kilo = projects[0];
---

<section id="kilo" tabindex="-1" class="tear" aria-labelledby="kilo-title">
  <div class="stage">
    <div class="pane pane-l" data-tear="l">
      <img src="/kilo/alimentacao-dia.webp" width="780" height="1688" alt="Kilo's food log for one day, in Portuguese: banana, boiled egg, French roll and rice, each with its calories" loading="lazy" />
    </div>
    <div class="pane pane-r" data-tear="r">
      <img src="/kilo/treino-resumo.webp" width="780" height="1688" alt="Kilo's workout summary, in Portuguese, with personal records and how much each exercise went up" loading="lazy" />
    </div>

    <h2 id="kilo-title" class="title">
      <span class="half half-l" data-tear="tl">Kilo</span>
      <span class="half half-r" data-tear="tr" aria-hidden="true">Kilo</span>
    </h2>

    <div class="card hard" data-tear="card">
      <p>An offline-first iPhone app for workout and food logging, built for Brazilians. Designed and built solo.</p>
      <p class="meta">Pre-launch · app screens are in Portuguese for now</p>
      <a href={kilo.href} class="btn btn-ink hard">kiloapp.com.br <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .tear { position: relative; }
  .stage {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: clip;
    background: var(--bg);
  }
  .pane { position: relative; overflow: clip; }
  .pane-l { background: var(--accent); }
  .pane-r { background: var(--surface); }
  .pane img {
    position: absolute;
    width: 46%;
    max-width: 22rem;
    height: auto;
  }
  .pane-l img { left: var(--m); }
  .pane-r img { right: var(--m); }
  /* The left screen hangs from the top edge and the right one rises from the bottom, so the two panes interlock. */
  .pane-l img { top: 4.25rem; }
  .pane-r img { bottom: 1.75rem; top: auto; }

  .title {
    position: absolute;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    width: 100%;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(6rem, 20vw, 21rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }
  /* The word is set twice, each copy clipped to its own half. */
  .half { display: block; }
  .half-l { color: var(--bg); clip-path: inset(0 50% 0 0); }
  .half-r { position: absolute; inset: 0; color: var(--fg); clip-path: inset(0 0 0 50%); }

  .card {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    width: min(26rem, calc(100% - 2 * var(--m)));
    padding: 1.25rem 1.4rem 1.4rem;
    background: var(--surface);
    border: 2px solid var(--fg);
    --sh: var(--accent);
    text-align: left;
  }
  .card:hover { translate: -50% 0; }
  .card p { font-size: var(--t-b); line-height: 1.4; }
  .card .meta { margin: 0.5rem 0 1rem; color: var(--muted); font-size: var(--t-s); }

  /* With the motion layer on, the section is two screens tall and the stage holds while the halves meet and part. */
  html.motion .tear { height: 230svh; }
  html.motion .stage { position: sticky; top: 0; }

  @media (max-width: 720px) {
    .stage { min-height: 38rem; }
    .pane-l img { top: 4rem; width: 78%; height: 34svh; object-fit: cover; object-position: top; }
    .pane-r img { display: none; }
    .title { font-size: 25vw; top: 52%; }
    .card .meta { display: none; }
    .card { bottom: 1rem; padding: 1rem 1.1rem 1.15rem; }
  }
</style>
