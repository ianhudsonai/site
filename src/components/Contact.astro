---
import { links } from '../data/site';

const rows = [
  { text: links.email, href: `mailto:${links.email}` },
  { text: 'github.com/ianhudsonai', href: links.github },
  { text: 'linkedin.com/in/ianhudsonvieira', href: links.linkedin },
  { text: 'x.com/ianhudsonai', href: links.x },
];
---

<section id="contact" tabindex="-1" class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="sr-only">Contact</h2>
  <ul>
    {
      rows.map((r) => (
        <li data-reveal>
          <a href={r.href}><span>{r.text}</span><i aria-hidden="true">↗</i></a>
        </li>
      ))
    }
    <li data-reveal class="hello">
      <a href={`mailto:${links.email}`}>
        <span>Say hello</span>
        <b aria-hidden="true">→</b>
      </a>
    </li>
  </ul>
</section>

<style>
  .contact { background: var(--bg); }
  ul { display: block; }
  li a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: clamp(5.25rem, 10.5vw, 9.5rem);
    padding: 0 var(--m) clamp(0.9rem, 1.8vw, 1.6rem);
    font-size: clamp(1.375rem, 5.3vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    overflow: clip;
  }
  li:nth-child(odd) a { background: var(--surface); }
  li a span { overflow-wrap: anywhere; }
  li a i { font-style: normal; font-size: 0.6em; color: var(--accent); transition: translate 0.4s var(--ease-zine), color 0.2s; }
  li a::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent); transform: translateY(101%); transition: transform 0.45s var(--ease-zine); }
  li a:hover, li a:focus-visible { color: var(--on-accent); outline-offset: -6px; }
  li a:hover::before, li a:focus-visible::before { transform: translateY(0); }
  li a:hover i, li a:focus-visible i { color: var(--on-accent); translate: 0.15em -0.15em; }

  li.hello a { justify-content: flex-start; gap: 0.5em; background: var(--accent); color: var(--on-accent); align-items: center; padding-bottom: 0; }
  li.hello a::before { background: var(--fg); }
  .hello b {
    display: inline-grid;
    place-items: center;
    width: 0.95em;
    height: 0.95em;
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg);
    font-size: 0.9em;
    line-height: 1;
    transition: translate 0.4s var(--ease-zine), rotate 0.4s var(--ease-zine);
  }
  li.hello a:hover b { translate: 0.15em 0; rotate: -45deg; }
</style>
