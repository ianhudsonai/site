---
import SectionLabel from './SectionLabel.astro';
import { projects } from '../data/site';

const tilts = ['-1.2deg', '1deg', '-0.6deg', '0.8deg'];
---

<section id="projects" tabindex="-1" aria-labelledby="projects-title" class="scroll-mt-14 border-t border-line">
  <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 md:py-28">
    <SectionLabel id="projects-title" title="Projects" />

    <ul class="mt-12 grid gap-10 md:grid-cols-2 md:gap-12">
      {
        projects.map((p, i) => (
          <li data-reveal>
            <a
              href={p.href}
              class="hard relative block h-full border-2 border-fg bg-surface p-6"
              style={`--rot: ${tilts[i % tilts.length]};`}
            >
              <span class="absolute -top-3.5 right-4 rotate-2 border-2 border-fg bg-accent px-2.5 py-0.5 font-mono text-xs font-bold uppercase text-on-accent">
                {p.status}
              </span>
              <h3 class="font-display text-3xl uppercase leading-none">{p.name}</h3>
              <p class="mt-4 leading-relaxed text-muted">{p.summary}</p>
              <p class="mt-6 break-all font-mono text-sm font-bold text-accent">{p.cta} →</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
