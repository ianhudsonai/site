---
const items = [
  { href: '#kilo', label: 'Kilo' },
  { href: '#meal', label: 'Weigh a meal' },
  { href: '#tools', label: 'Tools' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav">
  <a href="#top" class="nav-mark" aria-label="Ian Hudson Vieira, back to top">IHV</a>
  <nav aria-label="Sections">
    {items.map((i) => <a href={i.href}>{i.label}</a>)}
  </nav>
</header>

<style>
  /* Difference blending keeps the links legible over the dark ground, the orange fields and the paper plates alike. */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.2rem var(--m);
    background: var(--bg);
    color: var(--fg);
  }
  .nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-weight: 600;
    font-size: 1rem;
    text-underline-offset: 0.45em;
  }
  .nav a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 3px; }
  .nav-mark { font-family: var(--font-display); font-size: 1.25rem !important; letter-spacing: -0.02em; }
  nav { display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); }
  @media (max-width: 560px) {
    nav a:nth-child(2) { display: none; }
  }
</style>
