---
import { site, links } from '../data/site';
---

<section id="top" class="hero" aria-labelledby="name">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <h1 id="name" class="monument">
    <span class="ln ln-a"><span class="mask"><span class="w" data-hero="line">Ian</span></span> <span class="mask"><span class="w" data-hero="line">Hudson</span></span></span>
    <span class="ln ln-b"><span class="mask"><span class="w" data-hero="line">Vieira</span></span></span>
  </h1>
  <p class="sr-only">{site.role}. {links.email}</p>
  <div class="hero-main">
    <div class="hero-copy" data-hero="copy">
      <p class="hero-line">{site.tagline}</p>
      <a href="#work" class="btn hard">See the work <span aria-hidden="true">↓</span></a>
    </div>

    <pre class="hero-card hard" data-hero="plate"><code><span class="p">$</span> whoami
<span class="o">ian hudson vieira
builder from são paulo</span>
<span class="p">$</span> cat speaks
<span class="o">portuguese, english</span>
<span class="p">$</span> cat building
<span class="o">kilo, an offline-first iPhone app</span>
<span class="p">$</span> cat published
<span class="o">taco-br-mcp, on npm</span>
<span class="p">$</span> <span class="cur" aria-hidden="true"></span></code></pre>
  </div>

</section>

<script>
  import '../scripts/glyphs';
</script>

<style>
  .hero {
    --name: calc((100cqw - 2 * var(--m)) / 6.62);
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    padding: 4.5rem var(--m) 1.1rem;
    overflow: clip;
  }
  /* Sits behind everything in the hero. Pointer events are read from the section, so the field never blocks a link. */
  .field { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
    min-height: 0;
    grid-row: 1;
  }
  .hero-copy { position: relative; z-index: 2; padding-bottom: calc(var(--name) * 0.45); max-width: 26rem; }
  .hero-line {
    font-size: var(--t-l);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
    max-width: 18ch;
  }
  .hero-card {
    justify-self: end;
    margin-right: 5%;
    margin-bottom: calc(var(--name) * 0.55);
    width: min(100%, 30rem);
    padding: 1.25rem 1.4rem 1.3rem;
    background: var(--surface);
    border: 2px solid var(--fg);
    font-family: var(--font-mono); /* taste-skill-ignore: a literal shell transcript */
    font-size: var(--t-b);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .hero-card:hover { translate: none; }
  .hero-card .p { color: var(--accent); font-weight: 700; }
  .hero-card .o { color: var(--fg); }
  .hero-card code { font: inherit; }
  .cur { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: text-bottom; background: var(--accent); }
  html.motion .cur { animation: blink 1.1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }

  .monument {
    position: relative;
    z-index: 1;
    grid-row: 2;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--name);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-wrap: nowrap;
    font-kerning: normal;
  }
  .ln { display: block; }
  .mask { display: inline-block; overflow: clip; padding: 0.06em 0 0.02em; vertical-align: top; }
  .w { display: inline-block; }

  @media (max-width: 720px) {
    .hero { padding-top: 4rem; }
    .hero-main { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-card { order: -1; justify-self: stretch; margin: 0 0 0 0; width: auto; font-size: 1rem; }
    .hero-copy { padding-bottom: 1.25rem; }
    .hero-line { max-width: 24ch; }
  }
</style>
