---
import { site, links } from '../data/site';

const social = [
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'X', href: links.x },
  { label: 'Email', href: `mailto:${links.email}` },
];
---

<section id="top" class="relative isolate overflow-hidden" aria-labelledby="name">
  <!-- Halftone field, faded out toward the text. Decorative only. -->
  <div
    class="halftone pointer-events-none absolute inset-y-0 right-0 -z-10 w-full opacity-30 sm:w-3/5"
    style="mask-image: radial-gradient(ellipse at 85% 30%, #000 0%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at 85% 30%, #000 0%, transparent 70%);"
    data-parallax
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-5xl px-5 pb-20 pt-16 sm:px-8 sm:pb-32 sm:pt-28">
    <p data-reveal class="font-mono text-sm text-accent">
      <span aria-hidden="true">$ </span>whoami <span class="text-muted">// {site.role.toLowerCase()}</span>
    </p>

    <h1
      id="name"
      data-reveal
      class="mt-6 font-display text-[clamp(2.6rem,10.5vw,7.25rem)] uppercase leading-[0.92] tracking-tight"
      style="-webkit-text-stroke: 0; text-shadow: 5px 5px 0 var(--accent);"
    >
      Ian Hudson<br />Vieira
    </h1>

    <div data-reveal class="mt-10">
      <p
        class="hard relative inline-block max-w-xl border-2 border-fg bg-surface px-5 py-4 text-lg sm:text-xl"
        style="--rot: -1.2deg;"
      >
        {site.tagline}
      </p>
    </div>

    <nav data-reveal aria-label="Social links" class="mt-10 flex flex-wrap gap-3 font-mono text-sm">
      {
        social.map((s, i) => (
          <a
            href={s.href}
            class="hard border-2 border-fg bg-bg px-4 py-2 font-bold transition-colors hover:bg-accent hover:text-on-accent"
            style={`--rot: ${[1, -0.8, 1.4, -1.2][i]}deg;`}
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</section>
