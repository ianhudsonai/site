---
import { site, links } from '../data/site';
---

<section id="top" class="hero" aria-labelledby="pitch">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="who" data-hero="copy">{site.name}<span aria-hidden="true"> / </span><span class="where">{site.location}</span></p>
      <h1 id="pitch" class="pitch">
        {
          site.headline.map((line, i) => (
            <span class:list={['ln', { 'ln-accent': i === site.headline.length - 1 }]}>
              <span class="mask"><span class="w" data-hero="line">{line}</span></span>
            </span>
          ))
        }
      </h1>
      <p class="sr-only">{site.role}. {links.email}</p>
      <div class="hero-foot" data-hero="copy">
        <p class="hero-line">{site.intro}</p>
        <a href="#work" class="btn hard">See the work <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <pre class="hero-card hard" data-hero="plate"><code><span class="p">$</span> whoami
<span class="o">ian hudson vieira
builder from são paulo</span>
<span class="p">$</span> cat speaks
<span class="o">portuguese, english</span>
<span class="p">$</span> cat building
<span class="o">kilo, an offline-first iPhone app</span>
<span class="p">$</span> cat published
<span class="o">taco-br-mcp, on npm</span>
<span class="p">$</span> <span class="cur" aria-hidden="true"></span></code></pre>
  </div>
</section>

<script>
  import '../scripts/glyphs';
</script>

<style>
  /* One composition: the heading says what Ian does, the name sits small above it, and the shell card starts level
     with its first line, so the two read as a single block anchored to the foot of the screen. */
  .hero {
    /* The longest line is about 5.3em wide. The heading takes 58% of the row, or less on a short screen. */
    --pitch: min(calc((100cqw - 2 * var(--m)) * 0.58 / 5.5), 17svh);
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: 100svh;
    padding: 5.5rem var(--m) clamp(2.25rem, 7svh, 4.5rem);
    overflow: clip;
  }
  /* Sits behind everything in the hero. Pointer events are read from the section, so the field never blocks a link. */
  .field { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
    align-items: start;
  }
  .hero-copy { position: relative; z-index: 1; min-width: 0; }

  .who { margin-bottom: 1.1rem; font-size: var(--t-b); font-weight: 700; line-height: 1.2; }
  .where { color: var(--muted); font-weight: 600; }

  .pitch {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--pitch);
    line-height: 0.84;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-wrap: nowrap;
    font-kerning: normal;
  }
  .ln { display: block; }
  .ln-accent { color: var(--accent); }
  .mask { display: inline-block; overflow: clip; padding: 0.06em 0 0.02em; vertical-align: top; }
  .w { display: inline-block; }

  .hero-foot { margin-top: clamp(1.25rem, 3svh, 2rem); }
  .hero-line { max-width: 34ch; margin-bottom: 1.5rem; font-size: var(--t-l); font-weight: 600; line-height: 1.28; letter-spacing: -0.01em; text-wrap: pretty; }

  .hero-card {
    position: relative;
    z-index: 2;
    justify-self: end;
    /* Level with the first line of the heading. */
    margin-top: calc(1.1rem + var(--t-b) * 1.2);
    width: min(100%, 31rem);
    padding: 1.25rem 1.4rem 1.3rem;
    background: var(--surface);
    border: 2px solid var(--fg);
    font-family: var(--font-mono); /* taste-skill-ignore: a literal shell transcript */
    font-size: var(--t-b);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .hero-card:hover { translate: none; }
  .hero-card .p { color: var(--accent); font-weight: 700; }
  .hero-card .o { color: var(--fg); }
  .hero-card code { font: inherit; }
  .cur { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: text-bottom; background: var(--accent); }
  html.motion .cur { animation: blink 1.1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }

  @media (max-width: 900px) {
    .hero { --pitch: min(calc((100cqw - 2 * var(--m)) / 5.5), 13svh); padding-top: 4.75rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-card { justify-self: stretch; margin: 0; width: auto; font-size: 1rem; }
    .hero-line { font-size: 1.25rem; }
  }
</style>
